Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /MotionPlanning1
- Class: rviz_common/Help
  Name: Help
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Value: true
    Cell Size: 0.25
    Plane Cell Count: 8
  - Class: moveit_rviz_plugin/MotionPlanning
    Name: MotionPlanning
    # THREE robots can appear here, and MoveIt leaves most of it to defaults,
    # which is why it looks like three arms of different colours with no
    # explanation. Each one is stated explicitly below so the display means
    # something:
    #
    #   Scene Robot    SOLID  - the real arm, as /joint_states reports it
    #   Query Goal     ORANGE - where you are asking it to go (drag this)
    #   Planned Path   GHOST  - plays once when you press Plan, then goes away
    #
    # Query Start State stays off: the start is always where the arm already is,
    # and a fourth robot showing that adds nothing while driving real hardware.
    Planned Path:
      Loop Animation: false
      Show Robot Visual: true
      Show Robot Collision: false
      Show Trail: false            # else every waypoint leaves a copy behind
      Robot Alpha: 0.4             # clearly a preview, not the arm
      State Display Time: 0.05 s
      Trajectory Topic: display_planned_path
    Planning Scene Topic: monitored_planning_scene
    Robot Description: robot_description
    Scene Geometry:
      Scene Alpha: 1
    Scene Robot:
      Show Robot Visual: true
      Show Robot Collision: false
      Robot Alpha: 1               # was 0.5: the real arm should not be a ghost
    Value: true
    Planning Request:
      Planning Group: arm
      Interactive Marker Size: 0.15
      Query Goal State: true
      Query Start State: false
      Show Workspace: false
      Goal State Alpha: 1
      Goal State Color: 250; 128; 0
  Global Options:
    Fixed Frame: world
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.6
      Focal Point:
        X: 0.15
        Y: 0.0
        Z: 0.35
      Name: Current View
      Pitch: 0.45
      Target Frame: world
      Yaw: 0.9
Window Geometry:
  Height: 975
  QMainWindow State: 
  Width: 1200
