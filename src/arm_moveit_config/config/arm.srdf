<?xml version="1.0" encoding="UTF-8"?>
<!-- Semantic description: what the planner may move, what counts as the tool,
     and which link pairs need no collision check.

     Hand-written rather than produced by the Setup Assistant, so every entry
     has a recorded reason. The <disable_collisions> block is generated data -
     regenerate it with

         ros2 run arm_moveit_config analyse_self_collision.py

     and paste the result. Re-run after ANY change to a mesh, a joint limit or a
     link: correcting the collision meshes from the exporter's undersized boxes
     to true convex hulls moved four pairs from "can never touch" to touching in
     up to 21% of poses. -->
<robot name="arm">

  <!-- The 6 revolute joints, as a chain rather than a joint list so MoveIt can
       attach a kinematics solver: IK needs a base and a tip. The tip is tool0,
       not Link6_Gripper, whose origin is a CAD point buried in the casting. -->
  <group name="arm">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>

  <!-- A single finger on a lead screw, driven by an N20 motor. Not in use yet;
       the group is declared so the hardware can be switched on later without
       touching the semantic model. -->
  <group name="gripper">
    <joint name="Slider_39"/>
  </group>

  <!-- Named states. Every pose below was checked collision-free against the
       convex-hull geometry.

       home: all joints at zero and the arm stands straight up, a vertical
       column from the shoulder at z=0.159 to the tool at z=0.970. True by
       construction - the CAD's own zero was a bent pose, so a zero offset is
       baked into the six joint origins (zero_offsets_rad in
       arm_description/config/joint_parameters.yaml). The stacking was solved
       numerically; the wrist orientation had to be set by hand, because joint4
       and joint6 are rolls about the arm's own axis and an optimiser asked for
       "links stacked, tool up" has nothing to say about them. -->
  <group_state name="home" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>

  <!-- ready: arm folded forward, tool pointing straight down, tool0 at
       (0.250, 0.000, 0.250). Solved by least squares against the kinematics
       rather than hand-picked, and checked collision-free.

       It is the seed that makes top-down Cartesian goals solvable at all.
       Configurations where this arm can point its tool down are a narrow basin,
       because joint4 and joint5 are limited to +/-90 deg and the tool frame is
       tilted relative to the wrist; seeded from a generic pose, every top-down
       goal tested returned NO_IK_SOLUTION although solutions provably exist. -->
  <group_state name="ready" group="arm">
    <joint name="joint1" value="0.0001"/>
    <joint name="joint2" value="-0.5910"/>
    <joint name="joint3" value="1.8856"/>
    <joint name="joint4" value="1.3775"/>
    <joint name="joint5" value="-0.6572"/>
    <joint name="joint6" value="-0.0015"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="Slider_39" value="-0.065"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="Slider_39" value="-0.010"/>
  </group_state>

  <!-- End effector -->
  <end_effector name="gripper_ee" parent_link="tool0" group="gripper"
                parent_group="arm"/>

  <!-- Self-collision matrix. Generated by scripts/analyse_self_collision.py,
       6000 samples, seed 0, against the convex-hull meshes and the current
       joint zeros. "Adjacent" = parent and child of a joint, built touching.
       "Never" = no collision in any of 6000 random valid configurations.
       Everything not listed stays enabled; six pairs genuinely collide in some
       configurations, the worst Link6_Gripper against base_link at 1.0%.

       "Never" is a sampled verdict, not a proof: at 1500 samples
       Link5_Wrist2 <-> base_link came out Never, and at 6000 it collides.

       Re-run after ANY change to a mesh, a limit or a joint zero - a joint that
       can reach further can reach into the arm itself. Finger_Moving <->
       Link1_Shoulder was exempt until joint3's upper limit went from a guessed
       +120 to a measured +122.5 deg, which let the finger reach the shoulder;
       without re-running, MoveIt would have planned straight through it. -->
  <disable_collisions link1="Finger_Moving" link2="Link3_ForeArm" reason="Never"/>
  <disable_collisions link1="Finger_Moving" link2="Link4_Wrist1" reason="Never"/>
  <disable_collisions link1="Finger_Moving" link2="Link5_Wrist2" reason="Never"/>
  <disable_collisions link1="Finger_Moving" link2="Link6_Gripper" reason="Adjacent"/>
  <disable_collisions link1="Link1_Shoulder" link2="Link2_UpperArm" reason="Adjacent"/>
  <disable_collisions link1="Link1_Shoulder" link2="Link3_ForeArm" reason="Never"/>
  <disable_collisions link1="Link1_Shoulder" link2="Link4_Wrist1" reason="Never"/>
  <disable_collisions link1="Link1_Shoulder" link2="Link5_Wrist2" reason="Never"/>
  <disable_collisions link1="Link1_Shoulder" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="Link2_UpperArm" link2="Link3_ForeArm" reason="Adjacent"/>
  <disable_collisions link1="Link2_UpperArm" link2="Link4_Wrist1" reason="Never"/>
  <disable_collisions link1="Link2_UpperArm" link2="Link5_Wrist2" reason="Never"/>
  <disable_collisions link1="Link2_UpperArm" link2="base_link" reason="Never"/>
  <disable_collisions link1="Link3_ForeArm" link2="Link4_Wrist1" reason="Adjacent"/>
  <disable_collisions link1="Link3_ForeArm" link2="Link5_Wrist2" reason="Never"/>
  <disable_collisions link1="Link3_ForeArm" link2="Link6_Gripper" reason="Never"/>
  <disable_collisions link1="Link3_ForeArm" link2="base_link" reason="Never"/>
  <disable_collisions link1="Link4_Wrist1" link2="Link5_Wrist2" reason="Adjacent"/>
  <disable_collisions link1="Link4_Wrist1" link2="Link6_Gripper" reason="Never"/>
  <disable_collisions link1="Link4_Wrist1" link2="base_link" reason="Never"/>
  <disable_collisions link1="Link5_Wrist2" link2="Link6_Gripper" reason="Adjacent"/>

</robot>
