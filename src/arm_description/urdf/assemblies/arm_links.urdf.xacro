<?xml version="1.0"?>
<!-- Link and joint definitions for the 6-DOF arm.

     Generated by the Fusion URDF/XACRO Exporter v3.1.1. Meshes, inertias and
     joint origins are untouched from that export.

     Hand edits (full record in ../../CAD_PROVENANCE.md):
       1. joint1..joint5 changed from continuous to revolute with real limits -
          the exporter emits continuous because Fusion has no joint-limit
          concept, which tells the planner the servo can spin forever.
       2. Limits come from config/joint_parameters.yaml, not hard-coded.
       3. The generated <ros2_control> block was removed: it duplicated the
          top-level component name and covered only 5 of the 7 joints.
          Replaced by urdf/arm.ros2_control.xacro. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arm_links_macro">

  <xacro:property name="jp" value="${xacro.load_yaml('$(find arm_description)/config/joint_parameters.yaml')['joints']}"/>

  <!-- Masses and inertias below are the export's own numbers multiplied by
       this ratio: the export assumed steel, the links are printed plastic. Both
       are linear in density for fixed geometry, so one ratio corrects all of
       them. See `materials` in config/joint_parameters.yaml. -->
  <xacro:property name="mat"
                  value="${xacro.load_yaml('$(find arm_description)/config/joint_parameters.yaml')['materials']}"/>
  <xacro:property name="inertia_scale" value="${mat['real_density'] / mat['cad_density']}"/>

  <xacro:macro name="arm_links" params="prefix">

    <!-- Links -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="0.076321 0.072684 0.202821" rpy="0 0 0"/>
        <mass value="${9.034081 * inertia_scale}"/>
        <inertia ixx="${2.316074e-02 * inertia_scale}" ixy="${3.515350e-05 * inertia_scale}" ixz="${2.271177e-04 * inertia_scale}"
                 iyy="${2.715309e-02 * inertia_scale}" iyz="${-2.381957e-05 * inertia_scale}" izz="${2.288309e-02 * inertia_scale}"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.475055 -0.483602 -1.783774"/>
        <geometry>
          <mesh filename="package://arm_description/meshes/arm_final/base_link.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.475055 -0.483602 -1.783774"/>
        <geometry>
          <mesh filename="package://arm_description/meshes/arm_final/base_link_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Finger_Moving">
      <inertial>
        <origin xyz="0.037257 -0.010891 -0.007753" rpy="0 0 0"/>
        <mass value="${0.120169 * inertia_scale}"/>
        <inertia ixx="${1.661823e-05 * inertia_scale}" ixy="${3.383023e-05 * inertia_scale}" ixz="${-1.131234e-06 * inertia_scale}"
                 iyy="${1.303462e-04 * inertia_scale}" iyz="${3.306818e-07 * inertia_scale}" izz="${1.460898e-04 * inertia_scale}"/>
      </inertial>
      <visual>
        <origin xyz="-0.337624 0.045516 -0.110000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://arm_description/meshes/arm_final/Finger_Moving.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="-0.337624 0.045516 -0.110000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://arm_description/meshes/arm_final/Finger_Moving_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Link1_Shoulder">
      <inertial>
        <origin xyz="0.002585 -0.002164 0.115131" rpy="0 0 0"/>
        <mass value="${6.768340 * inertia_scale}"/>
        <inertia ixx="${2.324299e-02 * inertia_scale}" ixy="${2.938194e-04 * inertia_scale}" ixz="${-6.020666e-04 * inertia_scale}"
                 iyy="${2.726213e-02 * inertia_scale}" iyz="${2.979273e-04 * inertia_scale}" izz="${1.005333e-02 * inertia_scale}"/>
      </inertial>
      <visual>
        <origin xyz="-0.032726 0.000891 0.148997" rpy="1.570796 1.553030 1.495452"/>
        <geometry>
          <mesh filename="package://arm_description/meshes/arm_final/Link1_Shoulder.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="-0.032726 0.000891 0.148997" rpy="1.570796 1.553030 1.495452"/>
        <geometry>
          <mesh filename="package://arm_description/meshes/arm_final/Link1_Shoulder_convex.stl" scale="1 1 1"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Link2_UpperArm">
      <inertial>
        <origin xyz="0.060831 0.119464 -0.058692" rpy="0 0 0"/>
        <mass value="${5.986406 * inertia_scale}"/>
        <inertia ixx="${7.741966e-02 * inertia_scale}" ixy="${-3.217262e-02 * inertia_scale}" ixz="${7.160243e-04 * inertia_scale}"
                 iyy="${3.030921e-02 * inertia_scale}" iyz="${1.309183e-03 * inertia_scale}" izz="${8.353355e-02 * inertia_scale}"/>
      </inertial>
      <visual>
        <origin xyz="0.033719 -0.279617 -0.008501" rpy="2.938426 -1.486631 2.804588"/>
        <geometry>
          <mesh filename="package://arm_description/meshes/arm_final/Link2_UpperArm.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="0.033719 -0.279617 -0.008501" rpy="2.938426 -1.486631 2.804588"/>
        <geometry>
          <mesh filename="package://arm_description/meshes/arm_final/Link2_UpperArm_convex.stl" scale="1 1 1"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Link3_ForeArm">
      <inertial>
        <origin xyz="-0.039575 -0.007542 -0.030771" rpy="0 0 0"/>
        <mass value="${1.330720 * inertia_scale}"/>
        <inertia ixx="${1.572557e-03 * inertia_scale}" ixy="${-2.349421e-04 * inertia_scale}" ixz="${-2.542470e-04 * inertia_scale}"
                 iyy="${2.494637e-03 * inertia_scale}" iyz="${-6.231564e-05 * inertia_scale}" izz="${1.862394e-03 * inertia_scale}"/>
      </inertial>
      <visual>
        <origin xyz="-0.060464 -0.117656 -0.055737" rpy="-3.141593 0.000000 1.844230"/>
        <geometry>
          <mesh filename="package://arm_description/meshes/arm_final/Link3_ForeArm.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="-0.060464 -0.117656 -0.055737" rpy="-3.141593 0.000000 1.844230"/>
        <geometry>
          <mesh filename="package://arm_description/meshes/arm_final/Link3_ForeArm_convex.stl" scale="1 1 1"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Link4_Wrist1">
      <inertial>
        <origin xyz="0.001515 -0.000727 0.058566" rpy="0 0 0"/>
        <mass value="${0.840013 * inertia_scale}"/>
        <inertia ixx="${7.416029e-04 * inertia_scale}" ixy="${4.995912e-06 * inertia_scale}" ixz="${-4.585052e-05 * inertia_scale}"
                 iyy="${7.114832e-04 * inertia_scale}" iyz="${-1.678778e-06 * inertia_scale}" izz="${2.361099e-04 * inertia_scale}"/>
      </inertial>
      <visual>
        <origin xyz="0.052768 -0.193215 0.179037" rpy="1.560504 1.254180 1.711805"/>
        <geometry>
          <mesh filename="package://arm_description/meshes/arm_final/Link4_Wrist1.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="0.052768 -0.193215 0.179037" rpy="1.560504 1.254180 1.711805"/>
        <geometry>
          <mesh filename="package://arm_description/meshes/arm_final/Link4_Wrist1_convex.stl" scale="1 1 1"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}Link5_Wrist2">
      <inertial>
        <origin xyz="-0.034657 0.006637 -0.017083" rpy="0 0 0"/>
        <mass value="${0.862606 * inertia_scale}"/>
        <inertia ixx="${5.886771e-04 * inertia_scale}" ixy="${4.524816e-05 * inertia_scale}" ixz="${-2.010478e-04 * inertia_scale}"
                 iyy="${6.687693e-04 * inertia_scale}" iyz="${4.493353e-05 * inertia_scale}" izz="${6.092490e-04 * inertia_scale}"/>
      </inertial>
      <visual>
        <origin xyz="-0.043762 0.121239 -0.224690" rpy="1.574196 -0.298733 -1.747651"/>
        <geometry>
          <mesh filename="package://arm_description/meshes/arm_final/Link5_Wrist2.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="-0.043762 0.121239 -0.224690" rpy="1.574196 -0.298733 -1.747651"/>
        <geometry>
          <mesh filename="package://arm_description/meshes/arm_final/Link5_Wrist2_convex.stl" scale="1 1 1"/>
        </geometry>
      </collision>
    </link>

    <!-- Joints (internal to assembly) -->
    <joint name="${prefix}joint1" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}Link1_Shoulder"/>
      <origin xyz="0.074556 0.083272 0.202270" rpy="-1.579827 0.000160 0.017765"/>
      <axis xyz="0.000000 0.000000 1.000000"/>
      <limit lower="${jp['joint1']['lower']}" upper="${jp['joint1']['upper']}"
             effort="${jp['joint1']['effort']}" velocity="${jp['joint1']['velocity']}"/>
    </joint>

    <joint name="${prefix}joint2" type="revolute">
      <parent link="${prefix}Link1_Shoulder"/>
      <child link="${prefix}Link2_UpperArm"/>
      <origin xyz="0.055397 -0.006109 0.168494" rpy="1.570796 -0.458822 1.495452"/>
      <axis xyz="0.000000 0.000000 1.000000"/>
      <limit lower="${jp['joint2']['lower']}" upper="${jp['joint2']['upper']}"
             effort="${jp['joint2']['effort']}" velocity="${jp['joint2']['velocity']}"/>
    </joint>

    <joint name="${prefix}joint3" type="revolute">
      <parent link="${prefix}Link2_UpperArm"/>
      <child link="${prefix}Link3_ForeArm"/>
      <origin xyz="0.132173 0.260352 -0.089924" rpy="3.141593 0.000000 -1.730994"/>
      <axis xyz="0.000000 0.000000 1.000000"/>
      <limit lower="${jp['joint3']['lower']}" upper="${jp['joint3']['upper']}"
             effort="${jp['joint3']['effort']}" velocity="${jp['joint3']['velocity']}"/>
    </joint>

    <joint name="${prefix}joint4" type="revolute">
      <parent link="${prefix}Link3_ForeArm"/>
      <child link="${prefix}Link4_Wrist1"/>
      <origin xyz="-0.075564 -0.027775 -0.036337" rpy="-1.570796 -0.180069 1.844230"/>
      <axis xyz="0.000000 0.000000 1.000000"/>
      <limit lower="${jp['joint4']['lower']}" upper="${jp['joint4']['upper']}"
             effort="${jp['joint4']['effort']}" velocity="${jp['joint4']['velocity']}"/>
    </joint>

    <joint name="${prefix}joint5" type="revolute">
      <parent link="${prefix}Link4_Wrist1"/>
      <child link="${prefix}Link5_Wrist2"/>
      <origin xyz="0.016426 0.001425 0.082512" rpy="1.548283 1.427953 1.699301"/>
      <axis xyz="0.000000 0.000000 1.000000"/>
      <limit lower="${jp['joint5']['lower']}" upper="${jp['joint5']['upper']}"
             effort="${jp['joint5']['effort']}" velocity="${jp['joint5']['velocity']}"/>
    </joint>


  </xacro:macro>

</robot>