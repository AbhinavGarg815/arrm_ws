<?xml version="1.0"?>
<!-- Top-level robot description - the entry point.

     Build standalone with:
       xacro urdf/arm.urdf.xacro use_mock_hardware:=true > /tmp/arm.urdf
       check_urdf /tmp/arm.urdf

     Arguments: prefix (name prefix), use_mock_hardware (loopback vs the real
     Mega + ESP32), mega_port, esp32_port, use_fake_gripper (keep the gripper on
     mock even when the arm is real - it is not built yet).

     Generated by the Fusion URDF/XACRO Exporter v3.1.1; hand edits are listed
     in ../CAD_PROVENANCE.md. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arm">

  <xacro:arg name="prefix"            default=""/>
  <xacro:arg name="use_mock_hardware" default="true"/>
  <xacro:arg name="mega_port"         default="/dev/ttyACM0"/>
  <xacro:arg name="esp32_port"        default="/dev/ttyUSB0"/>
  <xacro:arg name="use_fake_gripper"  default="true"/>

  <xacro:property name="prefix" value="$(arg prefix)"/>
  <xacro:property name="params"
                  value="${xacro.load_yaml('$(find arm_description)/config/joint_parameters.yaml')}"/>
  <xacro:property name="jp"    value="${params['joints']}"/>
  <xacro:property name="mount" value="${params['base_mount']}"/>

  <!-- Materials (shared across all assemblies) -->
  <material name="Steel">
    <color rgba="1.000 1.000 1.000 1.0"/>
  </material>

  <!-- World frame - hand-added, not from CAD. The exporter leaves base_link in
       the Fusion design frame, where the waist axis points along +Y, so the
       robot loads lying on its side. This fixed joint re-seats it upright
       without touching a mesh or a joint origin. Values and their derivation
       are in config/joint_parameters.yaml under base_mount. -->
  <link name="${prefix}world"/>

  <joint name="${prefix}world_joint" type="fixed">
    <parent link="${prefix}world"/>
    <child  link="${prefix}base_link"/>
    <origin xyz="${mount['xyz'][0]} ${mount['xyz'][1]} ${mount['xyz'][2]}"
            rpy="${mount['rpy'][0]} ${mount['rpy'][1]} ${mount['rpy'][2]}"/>
  </joint>

  <!-- Assembly includes -->
  <xacro:include filename="$(find arm_description)/urdf/assemblies/Component92_step.urdf.xacro"/>
  <xacro:include filename="$(find arm_description)/urdf/assemblies/arm_links.urdf.xacro"/>

  <!-- Instantiate assemblies -->
  <xacro:Component92_step prefix="${prefix}"/>
  <xacro:arm_links        prefix="${prefix}"/>

  <!-- Mount joints (cross-assembly connections). Hand edit: both were
       continuous and limit-less; they now take their limits from
       joint_parameters.yaml like every other joint. -->
  <joint name="${prefix}joint6" type="revolute">
    <parent link="${prefix}Link5_Wrist2"/>
    <child  link="${prefix}Link6_Gripper"/>
    <origin xyz="-0.054997 0.021646 -0.028534" rpy="-1.644064 -1.526393 1.468139"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit lower="${jp['joint6']['lower']}" upper="${jp['joint6']['upper']}"
           effort="${jp['joint6']['effort']}" velocity="${jp['joint6']['velocity']}"/>
  </joint>

  <joint name="${prefix}Slider_39" type="prismatic">
    <parent link="${prefix}Link6_Gripper"/>
    <child  link="${prefix}Finger_Moving"/>
    <origin xyz="0.002255 -0.068272 0.025905" rpy="-1.570796 -1.294169 -3.092055"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit lower="${jp['Slider_39']['lower']}" upper="${jp['Slider_39']['upper']}"
           effort="${jp['Slider_39']['effort']}" velocity="${jp['Slider_39']['velocity']}"/>
  </joint>

  <!-- Tool frame - hand-added. Link6_Gripper's origin sits somewhere arbitrary
       inside the body; tool0 is the frame worth commanding: the point between
       the fingers, +Z along the approach direction (ROS-Industrial convention).
       Derived from the geometry - +Z from the wrist origin toward the far end of
       the fingers, +Y the finger closing direction, origin at the fingertip
       130.5 mm out.

       PROVISIONAL as an absolute TCP: derived from CAD, not measured on the
       built arm. Good enough to make "point the tool down" mean what you
       expect, not good enough to place a grasp to a millimetre. -->
  <link name="${prefix}tool0"/>
  <joint name="${prefix}tool0_joint" type="fixed">
    <parent link="${prefix}Link6_Gripper"/>
    <child  link="${prefix}tool0"/>
    <origin xyz="-0.017700 -0.000900 0.129300" rpy="0.000000 0.135844 -3.092055"/>
  </joint>

  <!-- ros2_control: one hardware component covering all 7 joints -->
  <xacro:include filename="$(find arm_description)/urdf/arm.ros2_control.xacro"/>
  <xacro:arm_ros2_control
      name="${prefix}arm_system"
      prefix="${prefix}"
      use_mock_hardware="$(arg use_mock_hardware)"
      use_fake_gripper="$(arg use_fake_gripper)"
      mega_port="$(arg mega_port)"
      esp32_port="$(arg esp32_port)"/>

</robot>
